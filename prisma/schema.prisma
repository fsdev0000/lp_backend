generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Founder {
  id           String   @id @default(uuid())
  email        String?  @unique
  name         String
  phone        String?
  companyName  String?
  revenueBand  String?
  createdAt    DateTime @default(now())

  assessments  Assessment[]
  transcripts  Transcript[]
  bookings     Booking[]
}

model Assessment {
  id            String   @id @default(uuid())
  founderId     String
  scores              String?
  resultTitle         String?
  overallScore        Float?
  tier                String?
  primaryFocus        String?
  greatestOpportunity String?
  openingQuestion     String?
  focusArea           String?
  createdAt           DateTime @default(now())

  founder       Founder  @relation(fields: [founderId], references: [id])
}

model Transcript {
  id               String   @id @default(uuid())
  founderId        String
  conversationLog  String?
  daisyScore       Int?
  createdAt        DateTime @default(now())

  founder          Founder  @relation(fields: [founderId], references: [id])
}

model Booking {
  id                String   @id @default(uuid())
  founderId         String
  ghlAppointmentId  String?
  scheduledAt       DateTime?
  status            String   @default("pending")
  createdAt         DateTime @default(now())

  founder           Founder  @relation(fields: [founderId], references: [id])
}

model Question {
  id        String   @id @default(uuid())
  domain    String
  text      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model PressureOption {
  id        String   @id @default(uuid())
  key       String   @unique
  title     String
  hint      String
  order     Int      @default(0)
}

model SystemConfig {
  key       String   @id
  value     String   // Store stringified JSON since sqlite doesn't have a native Json array column
  updatedAt DateTime @updatedAt
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String   // e.g., 'info', 'warn', 'error'
  action    String   // e.g., 'EMAIL_SENT', 'ASSESSMENT_SCORED'
  details   String?  // Serialized JSON of log context
  createdAt DateTime @default(now())
}

model ConsentAuditLog {
  id                String   @id @default(uuid())
  consentId         String
  anonymousId       String?
  eventType         String
  strictlyNecessary Boolean  @default(true)
  functional        Boolean
  analytics         Boolean
  marketing         Boolean
  personalization   Boolean
  policyVersion     String
  bannerVersion     String
  jurisdiction      String?
  ipAddress         String?
  userAgent         String?
  idempotencyKey    String   @unique
  createdAt         DateTime @default(now())

  @@index([consentId])
}

model Article {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String    @unique
  title           String
  excerpt         String
  pillar          String
  pillarColor     String?   @default("hsl(122,31%,42%)") @map("pillar_color")
  keywords        String[]  @default([])
  metaTitle       String    @map("meta_title")
  metaDescription String    @map("meta_description")
  publishDate     DateTime? @default(now()) @db.Date @map("publish_date")
  readingTime     Int?      @default(5) @map("reading_time")
  author          String?   @default("Lionel Eersteling")
  content         String
  published       Boolean?  @default(true)
  createdAt       DateTime? @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt       DateTime? @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@map("articles")
}

model NewsletterSubscriber {
  id                   String    @id @default(uuid())
  email                String    @unique
  firstName            String?   @map("first_name")
  consentGiven         Boolean   @default(true) @map("consent_given")
  consentDate          DateTime  @default(now()) @map("consent_date")
  consentSource        String    @default("website") @map("consent_source")
  privacyPolicyVersion String    @default("v2026.3") @map("privacy_policy_version")
  subscribed           Boolean   @default(true)
  unsubscribeToken     String?   @unique @map("unsubscribe_token")
  unsubscribedAt       DateTime? @map("unsubscribed_at")
  status               String    @default("subscribed")
  source               String?   @default("Website Footer")
  ghlContactId         String?
  firstIssueSent       Boolean   @default(false)
  firstIssueSentAt     DateTime?
  subscribedAt         DateTime  @default(now())
  createdAt            DateTime? @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt

  campaignRecipients   NewsletterCampaignRecipient[]

  @@map("newsletter_subscribers")
}

model NewsletterCampaign {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignKey      String    @unique @map("campaign_key")
  campaignMonth    String    @map("campaign_month")
  title            String
  subject          String
  pdfPath          String?   @map("pdf_path")
  status           String    @default("draft")
  approvalStatus   String    @default("pending") @map("approval_status")
  scheduledAt      DateTime? @map("scheduled_at")
  approvedAt       DateTime? @map("approved_at")
  sendStartedAt    DateTime? @map("send_started_at")
  sendCompletedAt  DateTime? @map("send_completed_at")
  totalRecipients  Int       @default(0) @map("total_recipients")
  totalSent        Int       @default(0) @map("total_sent")
  totalFailed      Int       @default(0) @map("total_failed")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  recipients       NewsletterCampaignRecipient[]

  @@map("newsletter_campaigns")
}

model NewsletterCampaignRecipient {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId        String    @map("campaign_id") @db.Uuid
  subscriberId      String    @map("subscriber_id")
  email             String
  status            String    @default("pending")
  sentAt            DateTime? @map("sent_at")
  failedAt          DateTime? @map("failed_at")
  providerMessageId String?   @map("provider_message_id")
  errorMessage      String?   @map("error_message")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  campaign          NewsletterCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriber        NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([campaignId, subscriberId], map: "uq_campaign_subscriber")
  @@map("newsletter_campaign_recipients")
}

model MasterclassEnrollment {
  id                    String    @id @default(uuid())
  email                 String
  fullName              String    @map("full_name")
  company               String
  role                  String?
  phone                 String?
  marketingConsent      Boolean   @default(false) @map("marketing_consent")
  privacyConsent        Boolean   @default(true) @map("privacy_consent")
  amount                Int       @default(75000)
  currency              String    @default("usd")
  paymentStatus         String    @default("pending") @map("payment_status")
  stripeSessionId       String?   @unique @map("stripe_session_id")
  stripePaymentIntentId String?   @map("stripe_payment_intent_id")
  accessGranted         Boolean   @default(false) @map("access_granted")
  sessionToken          String?   @unique @map("session_token")
  courseProgress        Int       @default(0) @map("course_progress")
  currentStage          Int       @default(1) @map("current_stage")
  source                String?
  metadata              String?
  referralCodeId        String?   @map("referral_code_id")
  referralCode          MasterclassReferralCode? @relation(fields: [referralCodeId], references: [id])
  paidAt                DateTime? @map("paid_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  submissions           MasterclassWorkbookSubmission[]
  bookings              MasterclassBooking[]

  @@index([email])
  @@index([referralCodeId])
  @@map("masterclass_enrollments")
}

model MasterclassReferralCode {
  id              String      @id @default(uuid())
  code            String      @unique // e.g. "0XQZ6IN", "DIVALOS"
  referrerName    String      @map("referrer_name") // "Danielle", "Divalos"
  referrerEmail   String?     @map("referrer_email")
  discountPercent Float       @default(33.33) @map("discount_percent") // 33.33%
  stripeCouponId  String?     @map("stripe_coupon_id")
  startDate       DateTime    @default(now()) @map("start_date")
  endDate         DateTime    @map("end_date")
  isActive        Boolean     @default(true) @map("is_active")
  maxUses         Int?        @map("max_uses")
  usedCount       Int         @default(0) @map("used_count")
  notes           String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  enrollments     MasterclassEnrollment[]

  @@index([code])
  @@map("masterclass_referral_codes")
}

model MasterclassWorkbookSubmission {
  id            String    @id @default(uuid())
  submissionRef String    @unique @map("submission_ref")
  enrollmentId  String?   @map("enrollment_id")
  email         String
  fullName      String    @map("full_name")
  company       String
  role          String?
  phone         String?
  status        String    @default("draft")
  currentStage  Int       @default(1) @map("current_stage")
  formData      String
  personalNotes String?   @map("personal_notes")
  submittedAt   DateTime? @map("submitted_at")
  lastSavedAt   DateTime  @default(now()) @map("last_saved_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  enrollment    MasterclassEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  bookings      MasterclassBooking[]

  @@index([email])
  @@index([submissionRef])
  @@map("masterclass_workbook_submissions")
}

model MasterclassBooking {
  id               String    @id @default(uuid())
  bookingRef       String    @unique @map("booking_ref")
  enrollmentId     String?   @map("enrollment_id")
  submissionId     String?   @map("submission_id")
  email            String
  fullName         String    @map("full_name")
  company          String
  slotTime         String    @map("slot_time")
  scheduledAt      DateTime? @map("scheduled_at")
  timezone         String    @default("GST (UTC+4)")
  status           String    @default("confirmed")
  meetingLink      String?   @map("meeting_link")
  ghlAppointmentId String?   @map("ghl_appointment_id")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  enrollment       MasterclassEnrollment?         @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  submission       MasterclassWorkbookSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([email])
  @@map("masterclass_bookings")
}
model AttributionVisit {
  id            String    @id @default(uuid())
  anonymousId   String?   @map("anonymous_id")
  module        String?   // e.g. 'masterclass', 'unmasked-private', 'diagnostics', 'roundtable', 'contact', 'home'
  landingPage   String    @map("landing_page")
  referrer      String?
  utmSource     String?   @map("utm_source")
  utmMedium     String?   @map("utm_medium")
  utmCampaign   String?   @map("utm_campaign")
  utmTerm       String?   @map("utm_term")
  utmContent    String?   @map("utm_content")
  ipAddress     String?   @map("ip_address")
  country       String?
  city          String?
  region        String?
  timezone      String?
  userAgent     String?   @map("user_agent")
  device        String?
  email         String?   // Populated when visitor converts on any lead form
  leadName      String?   @map("lead_name")
  leadForm      String?   @map("lead_form") // e.g. 'contact', 'unmasked_private', 'scan', 'masterclass'
  howDidYouHear String?   @map("how_did_you_hear")
  ghlContactId  String?   @map("ghl_contact_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([anonymousId])
  @@index([email])
  @@index([utmSource])
  @@index([createdAt])
  @@map("attribution_visits")
}

model AudiobookPurchase {
  id                    String    @id @default(uuid())
  bookId                String    @default("reset-by-discipline") @map("book_id")
  version               String    @default("en")
  customerEmail         String?   @map("customer_email")
  customerName          String?   @map("customer_name")
  amount                Int?
  currency              String    @default("usd")
  paymentStatus         String    @default("pending") @map("payment_status")
  stripeSessionId       String    @unique @map("stripe_session_id")
  stripePaymentIntentId String?   @map("stripe_payment_intent_id")
  accessGranted         Boolean   @default(false) @map("access_granted")
  accessToken           String    @unique @map("access_token")
  expiresAt             DateTime? @map("expires_at")
  paidAt                DateTime? @map("paid_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([bookId])
  @@index([accessToken])
  @@index([stripeSessionId])
  @@index([customerEmail])
  @@map("audiobook_purchases")
}

model PressureScanSubmission {
  id                      String    @id @default(uuid())
  referenceNumber         String    @unique @map("reference_number")
  methodologyVersion      String    @default("1.0") @map("methodology_version")
  questionSetVersion      String    @default("1.0") @map("question_set_version")
  fullName                String    @map("full_name")
  email                   String
  companyName             String    @map("company_name")
  phone                   String?
  submittedContext        Json?     @map("submitted_context")
  answers                 Json
  overallRawMean          Float     @map("overall_raw_mean")
  overallNormalised       Float     @map("overall_normalised")
  domainScores            Json      @map("domain_scores")
  primarySignalAreas      String[]  @map("primary_signal_areas")
  signalClassification    String    @map("signal_classification")
  methodologyAcknowledged Boolean   @map("methodology_acknowledged")
  privacyAcknowledged     Boolean   @map("privacy_acknowledged")
  marketingConsent        Boolean   @default(false) @map("marketing_consent")
  reviewStatus            String    @default("AWAITING_REVIEW") @map("review_status")
  reviewerNotes           String?   @db.Text @map("reviewer_notes")
  reviewerDecision        String?   @map("reviewer_decision")
  reviewedAt              DateTime? @map("reviewed_at")
  reviewedBy              String?   @map("reviewed_by")
  zoomMeetingUrl          String?   @map("zoom_meeting_url")
  scheduledReviewAt       DateTime? @map("scheduled_review_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  @@index([referenceNumber])
  @@index([email])
  @@index([reviewStatus])
  @@index([createdAt])
  @@map("pressure_scan_submissions")
}

model ScheduledEmail {
  id              String    @id @default(uuid())
  contactId       String    @map("contact_id")
  contactEmail    String    @map("contact_email")
  emailType       String    @map("email_type")
  subject         String
  htmlBody        String    @db.Text @map("html_body")
  sendAt          DateTime  @map("send_at")
  status          String    @default("pending") @map("status")
  scanType        String    @default("founder_pressure_scan") @map("scan_type")
  createdAt       DateTime  @default(now()) @map("created_at")
  sentAt          DateTime? @map("sent_at")
  errorMessage    String?   @db.Text @map("error_message")

  appointmentId   String?   @map("appointment_id")
  referenceNumber String?   @map("reference_number")
  retryCount      Int       @default(0) @map("retry_count")
  maxRetries      Int       @default(3) @map("max_retries")
  idempotencyKey  String?   @unique @map("idempotency_key")

  @@index([status, sendAt])
  @@index([contactEmail])
  @@index([referenceNumber])
  @@index([appointmentId])
  @@map("scheduled_emails")
}

